# ===== 本地开发使用（仅 dev，Vite proxy 同源转发；不会进入生产 bundle）=====
# Lux3D API Key（在 Aholo 开发者后台获取：https://labs.aholo.ai/api-keys）
VITE_LUX3D_API_KEY=your_api_key_here

# ===== 生产环境（GitHub Pages）=====
# Cloudflare Worker 反向代理地址，须以 /lux3d/v1 结尾；Key 由 Worker 在服务端注入，前端不携带
# VITE_LUX3D_PROXY=https://innolumina-lux3d-proxy.<your-account>.workers.dev/lux3d/v1
